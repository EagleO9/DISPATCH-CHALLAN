function searchChallanIds(query) {
  if (!query) return [];
  const q = String(query).toLowerCase().trim();
  if (!q) return [];

  const sh = SpreadsheetApp.getActive().getSheetByName("INWARD");
  if (!sh) return [];
  const last = sh.getLastRow();
  if (last < 2) return [];

  const vals = sh.getRange(2, 6, last - 1, 1).getValues();
  const out = [];
  const seen = new Set();
  // newest first
  for (let i = vals.length - 1; i >= 0; i--) {
    const v = String(vals[i][0]).trim();
    if (v && !seen.has(v) && v.toLowerCase().indexOf(q) !== -1) {
      seen.add(v);
      out.push(v);
      if (out.length >= 25) break;
    }
  }
  return out;
