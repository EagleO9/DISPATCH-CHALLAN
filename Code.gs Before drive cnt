=========================== */
const CACHE_TTL = 300; // 5 minutes
const CACHE_KEY_ITEMS = "v1_items_list";
const CACHE_KEY_ORDERS = "v1_orders_list";
const CACHE_KEY_CHALLANS = "v1_challans_list";
const CACHE_KEY_MASTER_PCS = "v1_master_pcs_map"; // NEW

function _getCache_() {
  return CacheService.getScriptCache();
}

function _invalidateListCaches_() {
  try {
    const c = _getCache_();
    c.removeAll([CACHE_KEY_ITEMS, CACHE_KEY_ORDERS, CACHE_KEY_CHALLANS]);
  } catch (e) { /* non-fatal */ }
}

/* ===========================
    FORMATTERS
=========================== */
function formatPDFDate_(d){
  try{
    const dt = new Date(d);
    const opts = { day: "numeric", month: "short", year: "numeric" };
    return dt.toLocaleDateString("en-GB", opts).replace(",", "");
  }catch(e){ return d; }
}

function formatPDFTime_(v){
  try{
    if (!v) return v;
    if (Object.prototype.toString.call(v) === "[object Date]") {
      return Utilities.formatDate(v, "Asia/Kolkata", "HH:mm:ss");
    }
    const m = String(v).match(/(\d{2}:\d{2}:\d{2})/);
    return m ? m[1] : v;
  }catch(e){ return v; }
}

function fmt2(v){
  const n = Number(v);
  return isNaN(n) ? "0.00" : n.toFixed(2);
}

/* ===========================
    MASTER PCS MAP (NEW — CACHED)
    Master sheet:
      Col A = Item Name
      Col B = PCS Per Bora
      Col C = PCS Per Bale
    Returns { lowercaseItemName: { bora: n, bale: n } }
=========================== */
function getMasterPcsMap_() {
  const cache = _getCache_();
  const cached = cache.get(CACHE_KEY_MASTER_PCS);
  if (cached) {
    try { return JSON.parse(cached); } catch(e) {}
  }

  const map = Object.create(null);
  const sh = SpreadsheetApp.getActive().getSheetByName("Master");
  if (!sh) return map;
  const last = sh.getLastRow();
  if (last < 2) return map;

  // A=Item, B=PCS Per Bora, C=PCS Per Bale
  const vals = sh.getRange(2, 1, last - 1, 3).getValues();
  for (let i = 0; i < vals.length; i++) {
    const name = String(vals[i][0] || "").trim().toLowerCase();
    if (!name) continue;
    if (!(name in map)) {
      map[name] = {
        bora: Number(vals[i][1]) || 0,
        bale: Number(vals[i][2]) || 0
      };
    }
  }

  try { cache.put(CACHE_KEY_MASTER_PCS, JSON.stringify(map), CACHE_TTL); } catch(e) {}
  return map;
}

// Returns the correct pcs-per-unit based on the packing type
function _pcsPerUnitFor_(pcsMap, itemName, packingType) {
  const key = String(itemName || "").trim().toLowerCase();
  const info = pcsMap[key];
  if (!info) return 0;
  return (String(packingType || "Bora").toLowerCase() === "bale") ? (info.bale || 0) : (info.bora || 0);
}

/* ===========================
    DROPDOWN LIST LOADERS (CACHED)
=========================== */
function getItemList() {
  const cache = _getCache_();
  const cached = cache.get(CACHE_KEY_ITEMS);
  if (cached) {
    try { return JSON.parse(cached); } catch(e) {}
  }

  const sh = SpreadsheetApp.getActive().getSheetByName("Master");
  if (!sh) return [];
  const last = sh.getLastRow();
  if (last < 2) return [];

  const values = sh.getRange(2, 1, last - 1, 1).getValues();
  const seen = new Set();
  const result = [];
  for (let i = 0; i < values.length; i++) {
    const v = values[i][0];
    if (v && !seen.has(v)) {
      seen.add(v);
      result.push(v);
    }
  }

  try { cache.put(CACHE_KEY_ITEMS, JSON.stringify(result), CACHE_TTL); } catch(e) {}
  return result;
}

function getChallanList(limit) {
  const cache = _getCache_();
  const cacheKey = CACHE_KEY_CHALLANS + "_" + (limit || "all");
  const cached = cache.get(cacheKey);
  if (cached) {
    try { return JSON.parse(cached); } catch(e) {}
  }

  const sh = SpreadsheetApp.getActive().getSheetByName("INWARD");
  if (!sh) return [];
  const last = sh.getLastRow();
  if (last < 2) return [];

  const vals = sh.getRange(2, 6, last - 1, 1).getValues();
  const out = [];
  const seen = new Set();
  for (let i = vals.length - 1; i >= 0; i--) {
    const v = String(vals[i][0]).trim();
    if (v && !seen.has(v)) {
      seen.add(v);
      out.push(v);
      if (limit && out.length >= limit) break;
    }
  }

  try { cache.put(cacheKey, JSON.stringify(out), CACHE_TTL); } catch(e) {}
  return out;
}

