var _allPackingList = [];

function _renderPackingSuggestions(matches, q) {
  const box = document.getElementById("packingSuggestions");
  if (!box) return;
  if (!matches || !matches.length) {
    box.innerHTML = '<div class="suggestion-item no-match">No matching Packing ID found</div>';
    box.style.display = 'block';
    return;
  }
  box.innerHTML = matches.map(m => {
    const safeAttr = _escAttr(m);
    return `<div class="suggestion-item" onclick="pickPackingSuggestion(\'${safeAttr}\')">${_highlightMatch(m, q)}</div>`;
  }).join('');
