// SUBMIT FORM — 4-LAYER DOUBLE ENTRY PROTECTION
// ============================================================
function submitForm(){

  // ===== Confirmation popup before submission (NEW) =====
  // Yes -> continue normally | Cancel -> stop submission
  if (!confirm("Are you sure you want to submit and generate PDF?")) {
    return;
  }

  if (__submitLock) {
    showToast("⚠️ Already processing! Please wait.", true);
    return;
  }

  const now = Date.now();
  if (now - __lastSubmitTime < SUBMIT_DEBOUNCE_MS) {
    showToast("⚠️ Please wait before submitting again.", true);
    return;
  }

  if (document.body.getAttribute("data-submitting") === "true") {
    showToast("⚠️ Submission already in progress!", true);
    return;
  }

  const sBtn = _DOM.submitBtn;
  if (sBtn.disabled) {
    showToast("⚠️ Already submitted! Do not click again.", true);
    return;
  }

  const date = _DOM.date.value;
  const customer = _DOM.mainCustomer.value.trim();
  const ship = _DOM.shipTo.value.trim();
  
  if(!date || !customer || !ship) {
    showToast("Fill Date, Customer and Ship-To", true);
    return;
  }

  const entries = [];
  let valid = true;
  let missingContractor = false;
  let missingType = false;

  const entryEls = _DOM.formContainer.querySelectorAll(".entry");
  const entryLen = entryEls.length;
  for (let ei = 0; ei < entryLen; ei++) {
    const en = entryEls[ei];
    const itemInput = en.querySelector("input[name='itemName']");
    const itemValue = itemInput.value;
    const descriptionValue = en.querySelector("input[name='itemDescription']").value.trim();
    
    const orderQty = en.querySelector("input[name='orderQty']").value || "";
    
    const contractorInput = en.querySelector("input[name='contractorName']");
    const contractor = contractorInput.value.trim();
    
    const packer = en.querySelector("input[name='packerName']").value.trim();
    const typeSelect = en.querySelector("select[name='packingType']");
    const packingType = typeSelect.value;   // dropdown only — manual select
    
    const boraInputs = en.querySelectorAll("input[data-bora]");
    const boras = [];
    for (let bi = 0; bi < boraInputs.length; bi++) {
      const v = boraInputs[bi].value;
      if (v !== "") boras.push(v);
    }

    if(!itemValue || itemValue.trim() === "") { 
      valid = false;
      en.style.borderColor = "red";
      itemInput.classList.add("error-input");
    } else {
      itemInput.classList.remove("error-input");
    }

    if(!contractor || contractor === "") {
      missingContractor = true;
      contractorInput.classList.add("error-input");
    } else {
      contractorInput.classList.remove("error-input");
    }

    // Type required ONLY for blocks that actually have weights entered
    if(boras.length > 0 && !packingType) {
      missingType = true;
      typeSelect.classList.add("error-input");
    } else {
      typeSelect.classList.remove("error-input");
    }

    if(itemValue && itemValue.trim() !== "" && contractor && contractor !== "" && packingType && boras.length > 0){
      en.style.borderColor = "#f1f5f9";
      entries.push({
        itemName: itemValue, 
        itemDescription: descriptionValue, 
        orderQty: orderQty,
        contractorName: contractor, 
        packerName: packer,
        packingType: packingType, 
        date: date, 
        customerName: customer, 
        shipTo: ship, 
        boras: boras
      });
    }
  }

  if(!valid) { 
    showAlert("Item Name cannot be empty."); 
    return; 
  }
  if(missingContractor) { 
    showAlert("Contractor Name is strictly required for all entries."); 
    return; 
  }
  if(missingType) {
    showAlert("Please select Type (Bora / Bale) for each item.");
    return;
  }
  if(entries.length === 0) { 
    showToast("Enter weights for at least one item", true); 
    return; 
  }

  _lockSubmission();

  const payload = {
    entries: entries,
    timestamp: getISTTimestamp(),
    duration: Math.floor((Date.now() - formStartTime)/1000),
    driverName: _DOM.driverName.value.trim(),
    vehicleNumber: _DOM.vehicleNumber.value.trim(),
    driverNumber: _DOM.driverNumber.value.trim(),
    loaderName: _DOM.loaderName.value.trim(),
    transportName: _DOM.transportName.value.trim(),
    pdfGenTime: _DOM.pdfGenTime.value,
    orderId: _DOM.loadOrderSel.value || "" 
  };

  if (typeof google !== 'undefined') {
    google.script.run
      .withSuccessHandler(function(resp){
        if (resp && resp.success === false) {
          showToast("❌ Error: " + (resp.error || "Unknown"), true);
          _unlockSubmission();
          return;
        }
        // ===== Robust filename download helper (NEW) =====
        // Converts data: URL to a Blob URL so the browser honours the filename.
        function _downloadWithName(dataUrl, filename) {
          try {
            if (!dataUrl) return;
            const safeName = String(filename || "download.pdf").replace(/[\\/:*?\"<>|]/g, "_");
            if (dataUrl.indexOf("data:") === 0) {
              const parts = dataUrl.split(",");
              const meta  = parts[0];
              const data  = parts.slice(1).join(",");
              const isB64 = meta.indexOf(";base64") !== -1;
              const mime  = (meta.match(/data:([^;]+)/) || [,"application/pdf"])[1];
              let byteStr;
              if (isB64) byteStr = atob(data);
              else       byteStr = decodeURIComponent(data);
              const len = byteStr.length;
              const bytes = new Uint8Array(len);
              for (let i = 0; i < len; i++) bytes[i] = byteStr.charCodeAt(i);
              const blob = new Blob([bytes], { type: mime });
              const url = URL.createObjectURL(blob);
              const a = document.createElement("a");
              a.href = url;
              a.download = safeName;
              a.style.display = "none";
              document.body.appendChild(a);
              a.click();
              setTimeout(function(){
                try { document.body.removeChild(a); } catch(e){}
                try { URL.revokeObjectURL(url); } catch(e){}
              }, 1500);
            } else {
              const a = document.createElement("a");
              a.href = dataUrl;
              a.download = safeName;
              document.body.appendChild(a);
              a.click();
              setTimeout(function(){ try { document.body.removeChild(a); } catch(e){} }, 1500);
            }
          } catch (e) {
            // last-resort fallback: open in new tab
            try { window.open(dataUrl, "_blank"); } catch(e2){}
          }
        }

        // Download single PDF (already named CustomerName_PCK-XXXX.pdf by the server)
        _downloadWithName(resp.dataUrl, resp.filename);
        showToast("✅ Success! PDF Downloaded.");
        _suppressUnloadWarning = true;   // NEW: data save ho gaya, ab reload pe confirm mat maango
        window.onbeforeunload = null;
        setTimeout(() => location.reload(), 2500); 
      })
      .withFailureHandler(function(err){
        showToast("❌ Error: " + err, true);
        _unlockSubmission();
      })
      .submitFormAndCreatePDF(payload);
  } else {
    setTimeout(() => {
      showToast("✅ Test Mode: Success! (No Google API detected)");
      _suppressUnloadWarning = true;   // NEW: test mode me bhi reload-warning band
      window.onbeforeunload = null;
      _unlockSubmission();
    }, 1500);
  }
}

function createSelectedDispatchPDF(){
  // Priority: search input value, then dropdown
  const searchVal = _DOM.dispatchSearch.value.trim();
  const dispatchId = searchVal || _DOM.dispatchSel.value;
  if(!dispatchId) return showToast("Type or select a Dispatch ID", true);
  showToast("Fetching Dispatch PDF for " + dispatchId + "...");
  if (typeof google !== 'undefined') {
    google.script.run
      .withSuccessHandler(function(resp){
        if (!resp || !resp.dataUrl) {
          showToast("❌ Dispatch PDF generation failed", true);
          return;
        }
        _downloadWithFilename(resp.dataUrl, resp.filename);
        showToast("✅ Dispatch PDF Downloaded");
      })
      .withFailureHandler(function(err){
        showToast("❌ " + (err.message || err), true);
      })
      .createChallanPDF(dispatchId);
  }
}

