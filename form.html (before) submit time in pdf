function duplicateEntry(btn) {
  const currentEntry = btn.closest(".entry");
  const pQtyInput = currentEntry.querySelector("input[name='pendingQty']");
  
  const currentTotal = parseInt(pQtyInput.value) || 0;
  const filledUnits = currentEntry.querySelectorAll("input[data-bora]").length;
  
  if (pQtyInput.value !== "-" && currentTotal <= filledUnits) {
    showAlert("❌ LIMIT REACHED!\n\nFilled all " + currentTotal + " units. Nothing left to split.");
    return;
  }

  let newBlockPending = pQtyInput.value === "-" ? "-" : (currentTotal - filledUnits);
  
  if (pQtyInput.value !== "-") {
    pQtyInput.value = filledUnits;
    showToast("Current block locked to " + filledUnits);
  }

  const data = {
    name: currentEntry.querySelector("input[name='itemName']").value,
    desc: currentEntry.querySelector("input[name='itemDescription']").value,
    oQty: currentEntry.querySelector("input[name='orderQty']").value,
    pQty: newBlockPending,
    type: currentEntry.querySelector("select[name='packingType']").value || ""
  };
  
  const newEntry = addEntry(null, true, data);
  currentEntry.insertAdjacentElement('afterend', newEntry);
  addBora(newEntry.querySelector(".btn-primary"));
  
  showToast("Balance " + newBlockPending + " units moved to next block.");
}

function removeEntry(btn){
  const entryToRemove = btn.closest(".entry");
  const itemName = entryToRemove.querySelector("input[name='itemName']").value;
  const itemDesc = entryToRemove.querySelector("input[name='itemDescription']").value;
  const pQtyRemoved = parseInt(entryToRemove.querySelector("input[name='pendingQty']").value) || 0;

  const allEntries = _DOM.formContainer.querySelectorAll(".entry");
  if(allEntries.length > 1){
    const entriesArr = Array.from(allEntries);
    const currentIndex = entriesArr.indexOf(entryToRemove);

    for (let i = currentIndex - 1; i >= 0; i--) {
      const prevEntry = entriesArr[i];
      const prevName = prevEntry.querySelector("input[name='itemName']").value;
      const prevDesc = prevEntry.querySelector("input[name='itemDescription']").value;
      const prevPQtyInput = prevEntry.querySelector("input[name='pendingQty']");

      if (prevName === itemName && prevDesc === itemDesc && prevPQtyInput.value !== "-") {
          const currentPrevVal = parseInt(prevPQtyInput.value) || 0;
          prevPQtyInput.value = currentPrevVal + pQtyRemoved;
          showToast("Stock (" + pQtyRemoved + ") returned to previous block.");
          break;
      }
    }

    entryToRemove.remove();
    recalcGrand();
  } else {
    showToast("At least one item is required", true);
  }
}

function addBora(btnOrEntry){
  const entry = btnOrEntry.closest ? btnOrEntry.closest(".entry") : btnOrEntry;
  const pQtyInput = entry.querySelector("input[name='pendingQty']");
  const div = entry.querySelector(".roll-fields");
  const currentCount = div.children.length;

  if (pQtyInput && pQtyInput.value && pQtyInput.value !== "-") {
      const max = parseInt(pQtyInput.value) || 0;
      if (max > 0 && currentCount >= max) {
          showToast(`Limit Reached! Block limit is ${max}`, true);
          return;
      }
  }

  const count = currentCount + 1;
  const w = document.createElement("div");
  w.className = "bora-item";
  w.innerHTML = `
    <span class="bora-sn">${count}.</span>
    <input type="number" data-bora step="0.01" placeholder="0.00" oninput="recalc(this)" onkeydown="handleEnter(event, this)">
  `;
  div.appendChild(w);
  w.querySelector("input").focus();
}

function handleEnter(e, input) {
  if (e.key === "Enter") {
    e.preventDefault();
    const entry = input.closest(".entry");
    const allInputs = entry.querySelectorAll("input[data-bora]");
    const arr = Array.from(allInputs);
    const currentIndex = arr.indexOf(input);
    if (currentIndex < arr.length - 1) {
      arr[currentIndex + 1].focus();
    } else {
      addBora(entry);
    }
  }
}

function removeBora(btn){
  const entry = btn.closest(".entry");
  const div = entry.querySelector(".roll-fields");
  if(div.lastChild) div.lastChild.remove();
  recalc(btn);
}

function recalc(el){
  if(!el) return;
  const entry = el.closest(".entry");
  let total = 0, count = 0;
  const inputs = entry.querySelectorAll("input[data-bora]");
  const len = inputs.length;
  for (let i = 0; i < len; i++) {
    const v = parseFloat(inputs[i].value) || 0;
    if(v > 0){ total += v; count++; }
  }
  entry.querySelector(".total-weight").textContent = total.toFixed(2);
  entry.querySelector(".bora-count").textContent = count;
  _scheduleGrandRecalc();
}

let _grandRecalcPending = false;
function _scheduleGrandRecalc() {
  if (_grandRecalcPending) return;
  _grandRecalcPending = true;
  requestAnimationFrame(function() {
    _grandRecalcPending = false;
    recalcGrand();
  });
}

function recalcGrand(){
  let gWeight = 0, gBora = 0;
  const entries = _DOM.formContainer.querySelectorAll(".entry");
  const len = entries.length;
  for (let i = 0; i < len; i++) {
    const en = entries[i];
    gWeight += parseFloat(en.querySelector(".total-weight").textContent) || 0;
    gBora += parseInt(en.querySelector(".bora-count").textContent) || 0;
  }
  _DOM.grandWeight.textContent = gWeight.toFixed(2);
  _DOM.grandBora.textContent = gBora;
  const hasData = gBora > 0;
  _DOM.bottomGrandSum.style.display = hasData ? "flex" : "none";
  _DOM.summaryWeight.textContent = gWeight.toFixed(2);
  _DOM.summaryBora.textContent = gBora;
}

// ============================================================
// REPRINT SEARCH — type last digits, get live suggestions
// ============================================================
function _escAttr(s) {
  return String(s).replace(/&/g,"&amp;").replace(/"/g,"&quot;").replace(/'/g,"&#39;");
}
function _escHtml(s) {
  return String(s).replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;");
}

// highlight the matched substring in suggestion
function _highlightMatch(text, query) {
  const t = String(text);
  if (!query) return _escHtml(t);
  const q = query.toLowerCase();
  const lower = t.toLowerCase();
  const idx = lower.indexOf(q);
  if (idx === -1) return _escHtml(t);
  const before = t.substring(0, idx);
  const match = t.substring(idx, idx + q.length);
  const after = t.substring(idx + q.length);
  return _escHtml(before) + '<span class="hl">' + _escHtml(match) + '</span>' + _escHtml(after);
}

function filterDispatchSuggestions(query) {
  const box = _DOM.dispatchSugg;
  if (!box) return;

  if (!query || !String(query).trim()) {
    box.style.display = 'none';
    box.innerHTML = '';
    return;
  }

  const q = String(query).trim().toLowerCase();
  // "contains" match so last digits, middle digits, anything works
  const matches = _allChallanList.filter(id => 
    String(id).toLowerCase().indexOf(q) !== -1
  ).slice(0, 20);

  if (matches.length === 0) {
    // not in cache → try server search as fallback
    box.innerHTML = '<div class="suggestion-item no-match">Searching server…</div>';
    box.style.display = 'block';
    if (typeof google !== 'undefined') {
      google.script.run.withSuccessHandler(function(serverMatches){
        // make sure user hasn't moved on
        const stillQuery = String(_DOM.dispatchSearch.value || "").trim().toLowerCase();
        if (stillQuery !== q) return;
        if (!serverMatches || serverMatches.length === 0) {
          box.innerHTML = '<div class="suggestion-item no-match">No matching Dispatch ID found</div>';
          return;
        }
        // merge into cache
        serverMatches.forEach(id => { if (_allChallanList.indexOf(id) === -1) _allChallanList.push(id); });
        _renderSuggestions(serverMatches, q);
      }).withFailureHandler(function(){
        box.innerHTML = '<div class="suggestion-item no-match">No matching Dispatch ID found</div>';
      }).searchChallanIds(query);
    } else {
      box.innerHTML = '<div class="suggestion-item no-match">No matching Dispatch ID found</div>';
    }
    return;
  }

  _renderSuggestions(matches, q);
}

function _renderSuggestions(matches, q) {
  const box = _DOM.dispatchSugg;
  box.innerHTML = matches.map(m => {
    const safeAttr = _escAttr(m);
    return `<div class="suggestion-item" onclick="pickDispatchSuggestion('${safeAttr}')">${_highlightMatch(m, q)}</div>`;
  }).join('');
  box.style.display = 'block';
}

function pickDispatchSuggestion(id) {
  _DOM.dispatchSearch.value = id;
  // sync dropdown if option exists
  const sel = _DOM.dispatchSel;
  let found = false;
  for (let i = 0; i < sel.options.length; i++) {
    if (sel.options[i].value === id) {
      sel.value = id;
      found = true;
      break;
    }
  }
  if (!found) sel.value = ""; // clear dropdown so search input wins
  _DOM.dispatchSugg.style.display = 'none';
}

function onDispatchSelectChange(value) {
  if (value) {
    _DOM.dispatchSearch.value = value;
    _DOM.dispatchSugg.style.display = 'none';
  }
}

function handleSearchKeydown(e) {
  if (e.key === "Enter") {
    e.preventDefault();
    // pick first suggestion if available, else just trigger download
    const firstItem = _DOM.dispatchSugg.querySelector('.suggestion-item:not(.no-match)');
    if (firstItem) {
      firstItem.click();
      setTimeout(createSelectedPDF, 80);
    } else {
      createSelectedPDF();
    }
  } else if (e.key === "Escape") {
    _DOM.dispatchSugg.style.display = 'none';
  }
}

// Hide suggestions on outside click
document.addEventListener('click', function(e) {
  if (!_DOM.dispatchSugg || !_DOM.dispatchSearch) return;
  if (!_DOM.dispatchSearch.contains(e.target) && !_DOM.dispatchSugg.contains(e.target)) {
