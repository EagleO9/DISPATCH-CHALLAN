}

function pickPackingSuggestion(id) {
  const input = document.getElementById("packingSearchInput");
  if (input) input.value = id;
  const sel = document.getElementById("packingSelect");
  if (sel) {
    // make sure option exists
    let found = false;
    for (let i = 0; i < sel.options.length; i++) {
      if (sel.options[i].value === id) { sel.selectedIndex = i; found = true; break; }
    }
    if (!found) {
      const opt = document.createElement("option");
      opt.value = id; opt.textContent = id;
      sel.appendChild(opt);
      sel.value = id;
    }
  }
  const box = document.getElementById("packingSuggestions");
  if (box) box.style.display = 'none';
}

function onPackingSelectChange(val) {
  const input = document.getElementById("packingSearchInput");
  if (input) input.value = val || "";
}

function handlePackingSearchKeydown(e) {
  if (e.key === "Enter") {
    e.preventDefault();
    createSelectedPackingPDF();
  }
}

function filterPackingSuggestions(value) {
  const box = document.getElementById("packingSuggestions");
  if (!box) return;
  const q = String(value || "").toLowerCase().trim();
  if (!q) {
    // show recent
    if (_allPackingList.length) {
      _renderPackingSuggestions(_allPackingList.slice(0, 25), "");
    } else {
      box.style.display = 'none';
    }
    return;
  }
  const local = _allPackingList.filter(id => String(id).toLowerCase().indexOf(q) !== -1);
  if (local.length) {
    _renderPackingSuggestions(local.slice(0, 25), q);
    return;
  }
  // server search
  if (typeof google !== "undefined") {
    google.script.run.withSuccessHandler(function(serverMatches){
      if (!serverMatches || !serverMatches.length) {
        box.innerHTML = '<div class="suggestion-item no-match">No matching Packing ID found</div>';
        box.style.display = 'block';
        return;
      }
      serverMatches.forEach(id => { if (_allPackingList.indexOf(id) === -1) _allPackingList.push(id); });
      _renderPackingSuggestions(serverMatches, q);
    }).withFailureHandler(function(){
      box.innerHTML = '<div class="suggestion-item no-match">No matching Packing ID found</div>';
      box.style.display = 'block';
    }).searchPackingIds(value);
  } else {
    box.innerHTML = '<div class="suggestion-item no-match">No matching Packing ID found</div>';
    box.style.display = 'block';
  }
}

function createSelectedPackingPDF(){
  const input = document.getElementById("packingSearchInput");
  const sel = document.getElementById("packingSelect");
  const searchVal = (input && input.value || "").trim();
  const packingId = searchVal || (sel && sel.value) || "";
  if(!packingId) return showToast("Type or select a Packing ID", true);
  showToast("Fetching Packing PDF for " + packingId + "...");
  if (typeof google !== 'undefined') {
    google.script.run
      .withSuccessHandler(function(resp){
        if (!resp || !resp.dataUrl) {
          showToast("❌ Packing PDF generation failed", true);
          return;
        }
        _downloadWithFilename(resp.dataUrl, resp.filename);
        showToast("✅ Packing PDF Downloaded");
      })
      .withFailureHandler(function(err){
        showToast("❌ " + (err.message || err), true);
      })
      .createPackingPDF(packingId);
  }
}

function showToast(msg, isError){
  const t = _DOM.toast;
  t.textContent = msg;
  t.style.borderLeft = isError ? "5px solid #ef4444" : "5px solid #22c55e";
  t.className = "show";
  setTimeout(() => t.className = "", 3000);
}


// ===== Global download helper (NEW) =====
function _downloadWithFilename(dataUrl, filename) {
  try {
    if (!dataUrl) return;
    const safeName = String(filename || "download.pdf").replace(/[\\/:*?\"<>|]/g, "_");
    if (dataUrl.indexOf("data:") === 0) {
      const parts = dataUrl.split(",");
      const meta  = parts[0];
      const data  = parts.slice(1).join(",");
      const isB64 = meta.indexOf(";base64") !== -1;
      const mime  = (meta.match(/data:([^;]+)/) || [,"application/pdf"])[1];
      let byteStr;
      if (isB64) byteStr = atob(data);
      else       byteStr = decodeURIComponent(data);
      const len = byteStr.length;
      const bytes = new Uint8Array(len);
      for (let i = 0; i < len; i++) bytes[i] = byteStr.charCodeAt(i);
      const blob = new Blob([bytes], { type: mime });
      const url = URL.createObjectURL(blob);
      const a = document.createElement("a");
      a.href = url; a.download = safeName; a.style.display = "none";
      document.body.appendChild(a); a.click();
      setTimeout(function(){ try { document.body.removeChild(a); } catch(e){} try { URL.revokeObjectURL(url); } catch(e){} }, 1500);
    } else {
      const a = document.createElement("a");
      a.href = dataUrl; a.download = safeName;
      document.body.appendChild(a); a.click();
      setTimeout(function(){ try { document.body.removeChild(a); } catch(e){} }, 1500);
    }
  } catch (e) { try { window.open(dataUrl, "_blank"); } catch(e2){} }
}

// ============================================================
// REFRESH / CLOSE GUARD (NEW)
// Agar form me koi data bhara hai aur user refresh/close kare,
// to browser pehle confirm maangega. Khaali form pe kuch nahi puchhega.
// Successful submit ke baad warning suppress ho jaati hai.
// (Yahan kuch delete/remove nahi hota — sirf confirm.)
// ============================================================
function _formHasData() {
  try {
    // 1) Koi bhi weight (bora/bale/box) bhara hai?
    const boraInputs = document.querySelectorAll("input[data-bora]");
    for (let i = 0; i < boraInputs.length; i++) {
      if (boraInputs[i].value && String(boraInputs[i].value).trim() !== "") return true;
    }
    // 2) Header fields
    if (_DOM.mainCustomer && _DOM.mainCustomer.value.trim()) return true;
    if (_DOM.shipTo && _DOM.shipTo.value.trim()) return true;
    if (_DOM.driverName && _DOM.driverName.value.trim()) return true;
    if (_DOM.vehicleNumber && _DOM.vehicleNumber.value.trim()) return true;
    if (_DOM.driverNumber && _DOM.driverNumber.value.trim()) return true;
    if (_DOM.loaderName && _DOM.loaderName.value.trim()) return true;
    if (_DOM.transportName && _DOM.transportName.value.trim()) return true;
    // 3) Item name ya Contractor bhara hai?
    const itemInputs = document.querySelectorAll("input[name='itemName']");
    for (let i = 0; i < itemInputs.length; i++) {
      if (itemInputs[i].value && String(itemInputs[i].value).trim() !== "") return true;
    }
    const contrInputs = document.querySelectorAll("input[name='contractorName']");
    for (let i = 0; i < contrInputs.length; i++) {
      if (contrInputs[i].value && String(contrInputs[i].value).trim() !== "") return true;
    }
  } catch (e) {}
  return false;
}

window.addEventListener("beforeunload", function(e) {
  // Success ke baad intentional reload -> warning mat dikhao
  if (_suppressUnloadWarning) return;
  // Submission chal raha hai YA form me data hai -> browser confirm maange
  if (__submitLock || _formHasData()) {
    e.preventDefault();
    e.returnValue = "";   // browser apna default "Leave site?" confirm dikhayega
    return "";
  }
});

window.onload = function() {
  _cacheDom();
  _DOM.pdfGenTime.value = getISTTimeOnly();
  initForm();

  const sBtn = _DOM.submitBtn;
  let __tapLock = false;

  function _handleSubmitEvent(e) {
    e.preventDefault();
    e.stopImmediatePropagation();

    if (__tapLock || __submitLock) return;

    __tapLock = true;

    requestAnimationFrame(function() {
      submitForm();
      setTimeout(function() { __tapLock = false; }, 5000);
    });
  }

  sBtn.addEventListener('touchstart', _handleSubmitEvent, { passive: false, capture: true });
  sBtn.addEventListener('click',      _handleSubmitEvent, { capture: true });
};
